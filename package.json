{
  "name": "deepseek-harness-plugins",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "plugins/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "check": "node scripts/check-plugin.mjs",
    "check:profile": "node scripts/check-profile.mjs",
    "test": "npm test --workspaces --if-present",
    "verify": "npm run build && npm run check && npm test"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "engines": {
    "node": ">=24"
  }
}
