{
  "name": "@dawn0608/dsh-session-cost",
  "version": "1.2.2",
  "type": "module",
  "main": "./lib/index.js",
  "description": "Shows Session cost at official unit prices and the account balance beside composer stats.",
  "license": "MIT",
  "author": "dawn0608",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "session-cost",
    "cost",
    "billing",
    "balance",
    "usage"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawn0608/dsh-plugins.git",
    "directory": "plugins/session-cost"
  },
  "homepage": "https://github.com/dawn0608/dsh-plugins/tree/main/plugins/session-cost",
  "bugs": {
    "url": "https://github.com/dawn0608/dsh-plugins/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
