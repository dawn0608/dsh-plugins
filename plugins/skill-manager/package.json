{
  "name": "@dawn0608/dsh-skill-manager",
  "version": "0.3.1",
  "type": "module",
  "main": "./lib/index.js",
  "description": "Search and preview global skills, with user skill switches affecting only the current Harness profile.",
  "license": "MIT",
  "author": "dawn0608",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0",
    "node": ">=24"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1",
    "@deepseek-ai/schemastery": "3.19.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawn0608/dsh-plugins.git",
    "directory": "plugins/skill-manager"
  },
  "homepage": "https://github.com/dawn0608/dsh-plugins/tree/main/plugins/skill-manager",
  "bugs": {
    "url": "https://github.com/dawn0608/dsh-plugins/issues"
  },
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "skills",
    "skill-manager",
    "dsh-plugin"
  ]
}
