{
  "name": "@dawn0608/dsh-mcp-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "description": "Manage Model Context Protocol servers from Settings and write them to the desktop profile patch.",
  "license": "MIT",
  "author": "dawn0608",
  "keywords": [
    "deepseek",
    "deepseek-harness",
    "dsh",
    "plugin",
    "mcp",
    "model-context-protocol",
    "settings"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dawn0608/dsh-plugins.git",
    "directory": "plugins/mcp-manager"
  },
  "homepage": "https://github.com/dawn0608/dsh-plugins/tree/main/plugins/mcp-manager",
  "bugs": {
    "url": "https://github.com/dawn0608/dsh-plugins/issues"
  },
  "engines": {
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node ../../scripts/build-plugin.mjs",
    "pretest": "npm run build",
    "test": "node --test test/*.test.mjs",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "yaml": "^2.9.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "external": [
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  }
}
